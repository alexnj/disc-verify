def permission_help(path):
    """How to get read access to the device: sudo on macOS; on Linux,
    usually membership in the group that owns the drive."""
    cmd = f"  sudo {' '.join(sys.argv)}"
    if not LINUX:
        return f"Run with sudo:\n{cmd}"
    try:
        group = grp.getgrgid(os.stat(path).st_gid).gr_name
    except (OSError, KeyError):
        return f"Run with sudo:\n{cmd}"
    return (f"Add yourself to the '{group}' group (then log in again):\n"
            f"  sudo usermod -aG {group} $USER\nor run with sudo:\n{cmd}")


def resume_command(sector):
    """This run's command line, set to start at `sector`."""
    args, skip = [], False
    for a in sys.argv[1:]:
        if skip:
            skip = False
        elif a in ("--start", "-s"):
            skip = True
        elif not a.startswith("--start="):
            args.append(a)
    prefix = "sudo " if os.geteuid() == 0 else ""
    return " ".join([prefix + os.path.basename(sys.argv[0])] + args
                    + ["--start", str(sector)])


def eject(dev):
    cmd = ["eject", dev] if LINUX else ["drutil", "eject"]
    try:
        subprocess.run(cmd, capture_output=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        pass


# --------------------------------------------------------------------------
# Finding the disc
# --------------------------------------------------------------------------

def drutil_status():
    try:
        return subprocess.run(["drutil", "status"], capture_output=True,
                              text=True, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def parse_drutil(out):
    """Return (device, media type string) from `drutil status` output."""
    dev = re.search(r"Name:\s*(/dev/disk\d+)", out)
    kind = re.search(r"Type:\s*(\S+)", out)
    return (dev.group(1) if dev else None, kind.group(1) if kind else None)


def linux_media(fd):
    """Media type of the disc in the drive, from its MMC current profile."""
    buf = ctypes.create_string_buffer(8)
    try:
        scsi_read(fd, [MMC_GET_CONFIGURATION, 0x02, 0, 0, 0, 0, 0, 0, 8, 0],
                  buf, 8)
    except OSError:
        return None
    return MMC_PROFILES.get(int.from_bytes(buf.raw[6:8], "big"))


def linux_find_disc():
    """Return (device, media type) for the first drive with a disc in it."""
    denied = None
    drives = sorted(glob.glob("/dev/sr[0-9]*"),
                    key=lambda d: int(re.sub(r"\D", "", d)))
    for dev in drives:
        try:
            fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
        except PermissionError:
            denied = denied or dev
            continue
        except OSError:
            continue
        try:
            if fcntl.ioctl(fd, CDROM_DRIVE_STATUS, CDSL_CURRENT) == CDS_DISC_OK:
                return dev, linux_media(fd)
        except OSError:
            pass
        finally:
            os.close(fd)
    # A drive we can't open may hold the disc; let the caller report that.
    return denied, None


def find_disc():
    """Return (device, media type string) for the disc in the drive."""
    if LINUX:
        return linux_find_disc()
    return parse_drutil(drutil_status())


def classify(media_type):
    """Map drutil's media type (CD-ROM, DVD+R, BD-RE, ...) to cd/dvd/bd."""
    t = (media_type or "").upper()
    for prefix, kind in (("CD", "cd"), ("DVD", "dvd"), ("BD", "bd")):
        if t.startswith(prefix):
            return kind
    return None


def raw_path(dev):
    """Prefer the raw (unbuffered) device node: /dev/diskN -> /dev/rdiskN."""
    m = re.fullmatch(r"/dev/disk(\d+)", dev)
    return f"/dev/rdisk{m.group(1)}" if m else dev


def device_size(path):
    """Return (block_count, block_size) for a device or image file."""
    fd = os.open(path, os.O_RDONLY)
    try:
        st = os.fstat(fd)
        if stat.S_ISREG(st.st_mode):
            return st.st_size // DATA_SECTOR, DATA_SECTOR
        if LINUX:
            bsize = struct.unpack("i", fcntl.ioctl(fd, BLKSSZGET, b"\0" * 4))[0]
            buf = fcntl.ioctl(fd, BLKGETSIZE64, b"\0" * 8)
            return struct.unpack("Q", buf)[0] // bsize, bsize
        buf = fcntl.ioctl(fd, DKIOCGETBLOCKSIZE, b"\0" * 4)
        bsize = struct.unpack("I", buf)[0]
        buf = fcntl.ioctl(fd, DKIOCGETBLOCKCOUNT, b"\0" * 8)
        return struct.unpack("Q", buf)[0], bsize
    finally:
        os.close(fd)


# --------------------------------------------------------------------------
# Readers
#
# read(lba, count) reads sectors [lba, lba+count). It raises OSError if the
# drive can't deliver them, and otherwise returns the LBAs the drive flagged
# as damaged-but-concealed (C2 errors), if it can tell.
# --------------------------------------------------------------------------

class Reader:
    name = ""
    sector_size = DATA_SECTOR
    chunk = 64                # sectors per bulk read

    def extents(self):
        """Inclusive (first, last) LBA ranges to verify."""
        return [(0, self.count - 1)]

    def locate(self, lba):
        return f"{100.0 * lba / max(self.count, 1):.1f}% into the disc"

    def close(self):
        pass


class RawReader(Reader):
    """Plain reads from the device node or image file."""
    name = "raw device"

    def __init__(self, path, count, sector_size=DATA_SECTOR):
        self.count = count
        self.sector_size = sector_size
        self.chunk = max(1, 128 * 1024 // sector_size)
        self.buf = None
        if LINUX and stat.S_ISBLK(os.stat(path).st_mode):
            # Bypass the page cache (the Linux counterpart of /dev/rdiskN),
            # so every read, and every retry, really goes to the disc.
            # O_DIRECT needs an aligned buffer; mmap memory is page-aligned.
            self.fd = os.open(path, os.O_RDONLY | os.O_DIRECT)
            self.buf = mmap.mmap(-1, self.chunk * sector_size)
        else:
            self.fd = os.open(path, os.O_RDONLY)

    def read(self, lba, count):
        n = count * self.sector_size
        offset = lba * self.sector_size
        if self.buf is not None:
            got = os.preadv(self.fd, [memoryview(self.buf)[:n]], offset)
        else:
            got = len(os.pread(self.fd, n, offset))
        if got != n:
            raise OSError(f"short read ({got} of {n} bytes)")
        return ()

    def close(self):
        os.close(self.fd)
        if self.buf is not None:
            self.buf.close()


def sg_capable(path):
    """True if `path` is a Linux block device that takes SCSI commands."""
    if not LINUX or not stat.S_ISBLK(os.stat(path).st_mode):
        return False
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    try:
        fcntl.ioctl(fd, SG_GET_VERSION_NUM, b"\0" * 4)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


class SgReader(Reader):
    """Linux: sends READ commands straight to the drive. Like O_DIRECT this
    bypasses the page cache, and it also skips the kernel's own retries,
    so a failing read costs one drive timeout instead of two."""
    name = "direct reads"

    def __init__(self, path, count, name=None, unlock=None):
        self.fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        self.count = count
        self.name = name or self.name
        # Called to unlock the drive again when it refuses encrypted sectors.
        # Tried once per run of refusals, so a disc that can't be unlocked
        # doesn't make every read pay for it.
        self.unlock, self.may_unlock = unlock, True
        try:
            # The largest transfer the kernel accepts, in 512-byte units.
            limit = struct.unpack("H", fcntl.ioctl(self.fd, BLKSECTGET,
                                                   b"\0" * 2))[0]
            self.chunk = max(1, min(64, limit * 512 // DATA_SECTOR))
        except OSError:
            self.chunk = 32
        self.buf = ctypes.create_string_buffer(self.chunk * DATA_SECTOR)

    def read(self, lba, count):
        n = count * DATA_SECTOR
        cdb = (bytes([MMC_READ_12, 0]) + lba.to_bytes(4, "big")
               + count.to_bytes(4, "big") + bytes([0, 0]))
        try:
            got = scsi_read(self.fd, cdb, self.buf, n)
        except ScsiError as e:
            if e.sense != SENSE_CSS_LOCKED or not (self.unlock
                                                   and self.may_unlock):
                raise
            self.may_unlock = False
            self.unlock()
            got = scsi_read(self.fd, cdb, self.buf, n)
        if got != n:
            raise OSError(f"short read ({got} of {n} bytes)")
        self.may_unlock = True
        return ()

    def close(self):
        os.close(self.fd)


def direct_reader(path, count, bsize):
    """The reader for plain sector reads of a device or image file."""
    if bsize == DATA_SECTOR and sg_capable(path):
        return SgReader(path, count)
    return RawReader(path, count, bsize)


def load_libdvdcss():
    candidates = [
        LIBDVDCSS_PATH,
        "/opt/homebrew/lib/libdvdcss.2.dylib",
        "/usr/local/lib/libdvdcss.2.dylib",
        "libdvdcss.so.2",
        ctypes.util.find_library("dvdcss"),
    ]
    for c in candidates:
        if c and (os.path.exists(c) or not c.startswith("/")):
            try:
                lib = ctypes.CDLL(c)
            except OSError:
                continue
            lib.dvdcss_open.restype = ctypes.c_void_p
            lib.dvdcss_open.argtypes = [ctypes.c_char_p]
            lib.dvdcss_close.argtypes = [ctypes.c_void_p]
            lib.dvdcss_seek.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
            lib.dvdcss_read.argtypes = [ctypes.c_void_p, ctypes.c_void_p,
                                        ctypes.c_int, ctypes.c_int]
            lib.dvdcss_error.restype = ctypes.c_char_p
            lib.dvdcss_error.argtypes = [ctypes.c_void_p]
            return lib
    return None


class DvdcssReader(Reader):
    """Reads through libdvdcss, which authenticates with the drive so that
    CSS-encrypted sectors can be read. Data is read raw (not decrypted);
    we only care whether the drive can deliver it."""
    name = "libdvdcss"

    def __init__(self, lib, path, count):
        self.lib = lib
        self.count = count
        os.environ.setdefault("DVDCSS_CACHE", "off")
        self.h = lib.dvdcss_open(path.encode())
        if not self.h:
            raise OSError("libdvdcss could not open the disc")
        self.buf = ctypes.create_string_buffer(self.chunk * DATA_SECTOR)

    def _err(self):
        msg = self.lib.dvdcss_error(self.h)
        return msg.decode(errors="replace") if msg else "read error"

    def read(self, lba, count):
        if self.lib.dvdcss_seek(self.h, lba, 0) != lba:
            raise OSError(f"seek failed: {self._err()}")
        if self.lib.dvdcss_read(self.h, self.buf, count, 0) != count:
            raise OSError(self._err())
        return ()

    def close(self):
        self.lib.dvdcss_close(self.h)


class Track:
    def __init__(self, number, first, last, audio):
        self.number, self.first, self.last, self.audio = number, first, last, audio
        self.stype = CD_TYPE_CDDA if audio else CD_TYPE_MODE1

    def __repr__(self):
        kind = "audio" if self.audio else "data"
        return f"Track({self.number}, {self.first}-{self.last}, {kind})"


def parse_full_toc(data):
    """Parse a full TOC (READ TOC format 2) into a list of Tracks.

    Layout: 2-byte big-endian length, first/last session, then 11-byte
    descriptors: session, ADR<<4|control, TNO, point, min, sec, frame,
    zero, pmin, psec, pframe. Point 1-99 is a track start, 0xA2 the
    session's lead-out. Control bit 0x04 marks a data track.
    """
    end = min(len(data), 2 + int.from_bytes(data[0:2], "big"))
    starts, leadouts = {}, {}
    for off in range(4, end - 10, 11):
        session, adr_ctl, _, point = data[off:off + 4]
        pmin, psec, pfr = data[off + 8:off + 11]
        if adr_ctl >> 4 != 1:
            continue
        lba = (pmin * 60 + psec) * CD_FPS + pfr - 150
        if 1 <= point <= 99:
            starts[point] = (session, lba, not adr_ctl & 0x04)
        elif point == 0xA2:
            leadouts[session] = lba
    tracks = []
    numbers = sorted(starts)
    for i, n in enumerate(numbers):
        session, first, audio = starts[n]
        nxt = starts.get(numbers[i + 1]) if i + 1 < len(numbers) else None
        if nxt and nxt[0] == session:
            last = nxt[1] - 1
        elif session in leadouts:
            last = leadouts[session] - 1
        else:
            continue
        if last >= first:
            tracks.append(Track(n, first, last, audio))
    return tracks


def c2_flagged(buf, count):
    """Indexes of sectors whose C2 error-flag block is non-zero, for a buffer
    of `count` sectors each laid out as 2352 bytes audio + 294 bytes flags."""
    size = CDDA_SECTOR + C2_SIZE
    return [i for i in range(count)
            if any(buf[i * size + CDDA_SECTOR:(i + 1) * size])]


class CDReader(Reader):
    """Reads CDs track by track with the CD-specific read ioctl, so audio
    tracks are read as 2352-byte CD-DA sectors and, when the drive
    supports it, with C2 error flags."""
    name = "CD reader"
    sector_size = CDDA_SECTOR
    chunk = 24

    def __init__(self, path):
        self.fd = os.open(path, os.O_RDONLY | (os.O_NONBLOCK if LINUX else 0))
        try:
            self.tracks = parse_full_toc(self._read_toc())
            if not self.tracks:
                raise OSError("no tracks found in the table of contents")
            self.starts = [t.first for t in self.tracks]
            self.count = self.tracks[-1].last + 1
            self.buf = ctypes.create_string_buffer(
                self.chunk * (CDDA_SECTOR + C2_SIZE))
            self.c2 = False
            self.c2_offset_size = CDDA_SECTOR + C2_SIZE
            if not any(t.audio for t in self.tracks):
                self.sector_size = DATA_SECTOR
            for t in self.tracks:
                if not t.audio:
                    self._probe_data_type(t)
            self._probe_c2()
        except BaseException:
            os.close(self.fd)
            raise

    def _read_toc(self):
        buf = ctypes.create_string_buffer(4096)
        if LINUX:
            cdb = [MMC_READ_TOC, 0x02, CD_TOC_FORMAT_FULL, 0, 0, 0, 1,
                   len(buf) >> 8, len(buf) & 0xFF, 0]
            return buf.raw[:scsi_read(self.fd, cdb, buf, len(buf))]
        req = dk_cd_read_toc_t(format=CD_TOC_FORMAT_FULL, formatAsTime=1,
                               bufferLength=len(buf),
                               buffer=ctypes.addressof(buf))
        fcntl.ioctl(self.fd, DKIOCCDREADTOC, req)
        return buf.raw[:req.bufferLength]

    def _ioctl(self, lba, count, area, stype, size, offset_size=None):
        n = count * size
        if LINUX:
            # READ CD addresses sectors directly, so offset_size (a quirk of
            # the macOS ioctl) doesn't apply.
            got = scsi_read(self.fd, read_cd_cdb(lba, count, area, stype),
                            self.buf, n)
            if got != n:
                raise OSError(f"short read ({got} of {n} bytes)")
            return self.buf.raw[:n]
        req = dk_cd_read_t(offset=lba * (offset_size or size),
                           sectorArea=area, sectorType=stype,
                           bufferLength=n, buffer=ctypes.addressof(self.buf))
        fcntl.ioctl(self.fd, DKIOCCDREAD, req)
        if req.bufferLength != n:
            raise OSError(f"short read ({req.bufferLength} of {n} bytes)")
        return self.buf.raw[:n]

    def _probe_data_type(self, track):
        """Data tracks can be mode 1 or mode 2 (CD-ROM XA, Video CD);
        use whichever type the drive accepts for the track's first sectors."""
        for stype in CD_DATA_TYPES:
            for lba in range(track.first, min(track.first + 16, track.last + 1)):
                try:
                    self._ioctl(lba, 1, CD_AREA_USER, stype, CD_USER_SIZE[stype])
                    track.stype = stype
                    return
                except OSError:
                    continue

    def _probe_c2(self):
        """Turn on C2 checking if the drive returns error flags for audio.
        Also confirm that the combined read addresses the same sector as a
        plain read (compare the audio), trying both offset conventions."""
        audio = [t for t in self.tracks if t.audio]
        if not audio:
            return
        t = max(audio, key=lambda t: t.last - t.first)
        mid = (t.first + t.last) // 2
        for lba in range(mid, min(mid + 20, t.last + 1)):
            try:
                plain = self._ioctl(lba, 1, CD_AREA_USER, CD_TYPE_CDDA,
                                    CDDA_SECTOR)
            except OSError:
                continue
            if not any(plain):
                continue      # silence would match any sector
            for offset_size in (CDDA_SECTOR + C2_SIZE, CDDA_SECTOR):
                try:
                    both = self._ioctl(lba, 1, CD_AREA_USER | CD_AREA_ERROR_FLAGS,
                                       CD_TYPE_CDDA, CDDA_SECTOR + C2_SIZE,
                                       offset_size)
                except OSError:
                    return
                if both[:CDDA_SECTOR] == plain:
                    self.c2 = True
                    self.c2_offset_size = offset_size
                    return
            return

    def track_at(self, lba):
        i = bisect.bisect_right(self.starts, lba) - 1
        t = self.tracks[max(i, 0)]
        return t if t.first <= lba <= t.last else None

    def extents(self):
        return [(t.first, t.last) for t in self.tracks]

    def locate(self, lba):
        t = self.track_at(lba)
        if not t:
            return f"sector {lba}"
        secs = (lba - t.first) // CD_FPS
        return f"track {t.number} at {secs // 60:02d}:{secs % 60:02d}"

    def read(self, lba, count):
        t = self.track_at(lba)
        if t.audio and self.c2:
            size = CDDA_SECTOR + C2_SIZE
            try:
                buf = self._ioctl(lba, count, CD_AREA_USER | CD_AREA_ERROR_FLAGS,
                                  CD_TYPE_CDDA, size, self.c2_offset_size)
                return [lba + i for i in c2_flagged(buf, count)]
            except OSError:
                pass          # fall through to a plain read
        try:
            self._ioctl(lba, count, CD_AREA_USER, t.stype, CD_USER_SIZE[t.stype])
            return ()
        except OSError:
            if count > 1:
                raise
        # A single sector the track's type can't read may still be readable
        # as another type (e.g. the gap between a data and an audio track).
        for stype in [CD_TYPE_CDDA] + CD_DATA_TYPES:
            if stype != t.stype:
                try:
                    self._ioctl(lba, 1, CD_AREA_USER, stype, CD_USER_SIZE[stype])
                    return ()
                except OSError:
                    pass
        raise OSError(f"unreadable sector {lba}")

    def close(self):
        os.close(self.fd)


# --------------------------------------------------------------------------
# DVD-Video cells
#
# Some DVD copy protections (ARccOS, RipGuard and the like) fill cells of the
# video files with deliberately damaged sectors and use the menus to steer
# players around them. Drives crawl through those cells, and some lock up
# after a while. Verification skips a slow cell as a whole, so we only need
# where the cells start and end.
# --------------------------------------------------------------------------

def merge_ranges(rs):
    """Sort inclusive (first, last) ranges and merge touching ones."""
    out = []
    for a, b in sorted(rs):
        if out and a <= out[-1][1] + 1:
            out[-1] = (out[-1][0], max(out[-1][1], b))
        else:
            out.append((a, b))
    return out


def iso9660_dir(read, lba, size):
    """{NAME: (lba, size)} for the entries of an ISO 9660 directory."""
    data = read(lba, (size + DATA_SECTOR - 1) // DATA_SECTOR)
    entries, off = {}, 0
    while off < len(data):
        n = data[off]
        if n == 0:        # records don't cross sectors; skip the padding
            off = (off // DATA_SECTOR + 1) * DATA_SECTOR
            continue
        rec = data[off:off + n]
        name = rec[33:33 + rec[32]].decode("ascii", "replace").split(";")[0]
        entries[name.upper()] = (int.from_bytes(rec[2:6], "little"),
                                 int.from_bytes(rec[10:14], "little"))
        off += n
    return entries


def ifo_cells(ifo, ifo_lba):
    """Absolute (first, last) sectors of the cells in an IFO's cell address
    tables: the menu cells and, for a title set, the title cells."""
    if ifo[:12] not in (b"DVDVIDEO-VMG", b"DVDVIDEO-VTS"):
        raise ValueError("not an IFO file")
    be = lambda off: int.from_bytes(ifo[off:off + 4], "big")
    tables = [(0xC0, 0xD8)]                  # menu VOBS, menu cell table
    if ifo[:12] == b"DVDVIDEO-VTS":
        tables.append((0xC4, 0xE0))          # title VOBS, title cell table
    cells = []
    for vobs_at, table_at in tables:
        vobs, table = be(vobs_at), be(table_at) * DATA_SECTOR
        if not vobs or not table:
            continue
        end = min(len(ifo), table + be(table + 4) + 1)
        for off in range(table + 8, end - 11, 12):
            first, last = be(off + 4), be(off + 8)
            if first <= last:
                cells.append((ifo_lba + vobs + first, ifo_lba + vobs + last))
    return cells


def dvd_cells(path):
    """Sorted (first, last) sectors of every DVD-Video cell on the disc, or
    [] if it isn't a DVD-Video disc with an ISO 9660 file system."""
    try:
        sg = sg_capable(path)
        fd = os.open(path, os.O_RDONLY | (os.O_NONBLOCK if sg else 0))
    except OSError:
        return []
    buf = ctypes.create_string_buffer(32 * DATA_SECTOR)

    def read(lba, count):
        if not sg:
            data = os.pread(fd, count * DATA_SECTOR, lba * DATA_SECTOR)
            if len(data) != count * DATA_SECTOR:
                raise OSError("short read")
            return data
        # Read exactly these sectors: reads through the kernel come in
        # 4 KB pages, and an IFO's last page can reach into an encrypted
        # VOB that the drive refuses to read.
        data = b""
        while count:
            n = min(count, 32)
            cdb = (bytes([MMC_READ_12, 0]) + lba.to_bytes(4, "big")
                   + n.to_bytes(4, "big") + bytes([0, 0]))
            if scsi_read(fd, cdb, buf, n * DATA_SECTOR) != n * DATA_SECTOR:
                raise OSError("short read")
            data += buf.raw[:n * DATA_SECTOR]
            lba, count = lba + n, count - n
        return data

    try:
        pvd = read(16, 1)
        if pvd[0:6] != b"\x01CD001":
            return []
        root = pvd[156:190]
        top = iso9660_dir(read, int.from_bytes(root[2:6], "little"),
                          int.from_bytes(root[10:14], "little"))
        if "VIDEO_TS" not in top:
            return []
        cells = set()
        for name, (lba, size) in iso9660_dir(read, *top["VIDEO_TS"]).items():
            if re.fullmatch(r"VIDEO_TS\.IFO|VTS_\d\d_0\.IFO", name):
                try:
                    ifo = read(lba, (size + DATA_SECTOR - 1) // DATA_SECTOR)
                    cells.update(ifo_cells(ifo, lba))
                except (OSError, ValueError, IndexError):
                    continue      # still use the cells of the others
        return sorted(cells)
    except (OSError, ValueError, IndexError):
        return []
    finally:
        os.close(fd)


