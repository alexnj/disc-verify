def fmt_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1000


def fmt_time(s):
    s = int(s)
    return f"{s // 3600}:{s // 60 % 60:02d}:{s % 60:02d}"


def ranges(sectors):
    """Collapse sorted sector numbers into (first, last) runs."""
    out = []
    for s in sectors:
        if out and s == out[-1][1] + 1:
            out[-1][1] = s
        else:
            out.append([s, s])
    return out


class Progress:
    def __init__(self, total, sector_size, quiet):
        self.total = total
        self.sector_size = sector_size
        self.quiet = quiet or not sys.stderr.isatty()
        self.start = time.monotonic()
        self.last = 0.0

    def line(self, done, bad, now, skipped=0):
        elapsed = max(now - self.start, 1e-6)
        rate = done * self.sector_size / elapsed
        eta = (self.total - done) * self.sector_size / rate if rate > 0 else 0
        pct = 100.0 * done / self.total if self.total else 100.0
        return (f"\r  {pct:5.1f}%  {fmt_bytes(done * self.sector_size):>9} / "
                f"{fmt_bytes(self.total * self.sector_size)}  "
                f"{rate / 1e6:5.1f} MB/s  ETA {fmt_time(eta)}  "
                f"problem sectors: {bad}"
                + (f"  skipped: {skipped}" if skipped else "") + "   ")

    def update(self, done, bad, skipped=0, force=False):
        now = time.monotonic()
        if self.quiet or (not force and now - self.last < 0.5):
            return
        self.last = now
        sys.stderr.write(self.line(done, bad, now, skipped))
        sys.stderr.flush()

    def note(self, msg):
        if not self.quiet:
            sys.stderr.write("\r\033[K")
        print(msg, flush=True)

    def finish(self):
        if not self.quiet:
            sys.stderr.write("\n")


SLOW_READ = 1.5           # seconds; a healthy read takes a fraction of that
SLOW_STREAK = 3           # this many slow reads in a row mean a slow region
FIRST_JUMP = 1024         # sectors; first step past a slow region, doubling
MAX_JUMP = 65536          # sectors; the largest single step past a slow region
AFTER_SKIP = 16           # chunks after a skip in which one slow read is enough
GROUP_GAP = 4096          # sectors; skips closer than this are reported as one


class DriveStuck(Exception):
    pass


class Result:
    def __init__(self, bad, c2, skipped, done, stopped, resume=None):
        self.bad = bad            # unreadable sectors
        self.c2 = c2              # sectors read with C2 errors
        self.skipped = skipped    # (first, last) ranges skipped as too slow
        self.done = done          # sectors checked (or skipped)
        self.stopped = stopped    # None, "interrupted" or "stuck"
        self.resume = resume      # if stopped: where to continue


def verify(reader, retries, quiet=False, thorough=False, cells=(),
           clock=time.monotonic):
    """Read every sector in reader.extents(), in three passes:

    1. Read in chunks. Chunks that fail are set aside for pass 2. Where
       reads become very slow, skip ahead (unless `thorough`): copy
       protection decoys and badly damaged areas can take hours to crawl
       through, and some drives lock up in them, so touch them as little as
       possible. Inside a DVD-Video cell (`cells`, sorted (first, last)),
       skip the rest of the cell; elsewhere, probe further and further
       ahead until reads are quick again.
    2. Read the failed chunks sector by sector to find the bad sectors.
    3. Retry each bad sector `retries` more times.

    Whenever a read fails slowly, re-read a sector that read fine earlier.
    If that fails too, the drive has stopped responding, and everything
    after that would be reported as bad, so stop."""
    extents = reader.extents()
    total = sum(last - first + 1 for first, last in extents)
    bad, c2, skipped, failed = set(), [], [], []
    progress = Progress(total, reader.sector_size, quiet)
    done = 0
    canary = recent = None      # the first and the latest sector read fine
    resume = None               # where pass 1 had got to
    pending, pending_at = 0, None   # failed[pending:] not rechecked yet,
                                    # the first of them from pending_at on

    def update(force=False):
        progress.update(done, len(bad) + len(c2),
                        sum(b - a + 1 for a, b in skipped), force)

    def timed_read(lba, count):
        """Return (C2 suspects, or None if the read failed; whether it was
        slow). Checks the drive after a slow failure."""
        start = clock()
        try:
            suspects = list(reader.read(lba, count))
        except OSError:
            suspects = None
        slow = clock() - start > SLOW_READ
        if suspects is None and slow and canary is not None:
            # Try the latest good sector first: a drive in a bad state can
            # fail on some parts of the disc (often near the start) while
            # still reading others.
            for s in [recent, recent, canary, canary]:
                try:
                    reader.read(s, 1)
                    break
                except OSError:
                    pass
            else:
                raise DriveStuck()
        return suspects, slow

    def read_one(s, attempts):
        """Read one sector up to `attempts` times: 'ok', 'c2' or 'bad'."""
        result = "bad"
        for _ in range(attempts):
            suspects, _ = timed_read(s, 1)
            if suspects == []:
                return "ok"
            if suspects:
                result = "c2"
        return result

    def check_c2(s):
        """A sector read with C2 errors; see whether a re-read is clean."""
        if read_one(s, retries) == "ok":
            return
        c2.append(s)
        progress.note(f"  damaged sector {s}, C2 errors ({reader.locate(s)})")

    stretch = None    # [first, last] of the slow stretch being skipped

    def skip(first, last):
        """Record a skipped range. Skips close together are one slow
        stretch, reported as one when it ends (see end_stretch)."""
        nonlocal stretch
        skipped.append((first, last))
        if stretch and first - stretch[1] <= GROUP_GAP:
            stretch = [min(stretch[0], first), max(stretch[1], last)]
        else:
            end_stretch()
            stretch = [first, last]

    def end_stretch():
        nonlocal stretch
        if not stretch:
            return
        first, last = stretch
        areas = merge_ranges([r for r in skipped
                              if first <= r[0] and r[1] <= last])
        n = sum(b - a + 1 for a, b in areas)
        where = reader.locate(first)
        if len(areas) == 1:
            progress.note(f"  skipped sectors {first}-{last}, the drive "
                          f"reads them very slowly ({where})")
        else:
            progress.note(f"  skipped {n:,} sectors in {len(areas)} slow "
                          f"areas between sectors {first} and {last} "
                          f"({where})")
        stretch = None

    def cell_end(lba):
        """Last sector of the (smallest) DVD-Video cell holding lba."""
        i = bisect.bisect_right(cells, (lba, float("inf")))
        ends = [b for a, b in cells[max(0, i - 64):i] if a <= lba <= b]
        return min(ends) if ends else None

    def is_slow(lba, last):
        return timed_read(lba, min(reader.chunk, last - lba + 1))[1]

    def skip_slow_region(lba, last, jump):
        """Skip a slow region starting at `lba`; return (where to resume,
        the step to use if the next region is slow too)."""
        end = cell_end(lba - 1)       # the cell of the last slow read
        if end is not None:
            # Cells can be huge; if the region goes on, the first slow read
            # after this skip triggers the next one.
            pos = min(max(end + 1, lba), lba + MAX_JUMP, last + 1)
        else:
            # Probe further and further ahead. Slow regions can be patchy,
            # so resume only where two reads in a row are quick.
            pos = lba
            while True:
                pos = min(pos + jump, last + 1)
                jump = min(jump * 2, MAX_JUMP)
                if pos > last or not is_slow(pos, last) and (
                        pos + reader.chunk > last
                        or not is_slow(pos + reader.chunk, last)):
                    break
        if pos > lba:
            skip(lba, pos - 1)
        return pos, jump

    try:
        # Pass 1
        jump, since_skip = FIRST_JUMP, None
        for first, last in extents:
            lba, streak = first, 0
            while lba <= last:
                resume = lba
                count = min(reader.chunk, last - lba + 1)
                suspects, slow = timed_read(lba, count)
                if suspects is None:
                    failed.append((lba, count))
                else:
                    canary = lba if canary is None else canary
                    recent = lba
                    done += count
                    for s in suspects:
                        check_c2(s)
                if slow and not streak:
                    streak_start = lba
                streak = streak + 1 if slow else 0
                lba += count
                # Right after a skip, a single slow read means we haven't
                # got past the slow region yet: skip again, further.
                after_skip = since_skip is not None and since_skip < AFTER_SKIP
                if since_skip is not None:
                    since_skip += 1
                if stretch and lba - stretch[1] > GROUP_GAP:
                    end_stretch()         # reads have been quick for a while
                if not after_skip:
                    jump = FIRST_JUMP
                if (not thorough and lba <= last and slow
                        and (streak >= SLOW_STREAK or after_skip)):
                    resume, jump = skip_slow_region(lba, last, jump)
                    done += resume - lba
                    # Chunks that failed in the streak that led here are part
                    # of the slow region too; rechecking them sector by
                    # sector would mean a long wait for each sector.
                    for f in [f for f in failed if f[0] >= streak_start]:
                        failed.remove(f)
                        skip(f[0], f[0] + f[1] - 1)
                        done += f[1]
                    lba, streak, since_skip = resume, 0, 0
                update()

        end_stretch()

        # Pass 2
        if failed:
            progress.note(f"  rechecking {len(failed)} failed area(s) sector "
                          "by sector")
        resume = None
        for i, (lba, count) in enumerate(failed):
            pending, streak = i, 0
            for s in range(lba, lba + count):
                pending_at = s
                suspects, slow = timed_read(s, 1)
                done += 1
                if suspects is None:
                    bad.add(s)
                else:
                    canary = s if canary is None else canary
                    recent = s
                    for s2 in suspects:
                        check_c2(s2)
                streak = streak + 1 if slow else 0
                if streak >= SLOW_STREAK and not thorough and s < lba + count - 1:
                    skip(s + 1, lba + count - 1)
                    end_stretch()
                    done += lba + count - 1 - s
                    break
                update()
        pending = len(failed)

        # Pass 3
        for s in sorted(bad):
            result = read_one(s, retries)
            if result != "bad":
                bad.discard(s)
            if result == "c2":
                c2.append(s)
            if result != "ok":
                what = "unreadable" if result == "bad" else "damaged"
                progress.note(f"  {what} sector {s} ({reader.locate(s)})")
            update()
        stopped = None
    except (KeyboardInterrupt, Stop):
        stopped = "interrupted"
    except DriveStuck:
        stopped = "stuck"
    end_stretch()
    if stopped:
        # Chunks that failed but weren't narrowed down to sectors yet count
        # as unreadable. The resume point stays where pass 1 got to, so a
        # later run doesn't go straight back into what may have hung the
        # drive.
        for i, (lba, count) in enumerate(failed[pending:]):
            first = pending_at if i == 0 and pending_at is not None else lba
            bad.update(range(first, lba + count))
    if not stopped:
        update(force=True)
    progress.finish()
    return Result(sorted(bad), sorted(c2), merge_ranges(skipped), done, stopped,
                  resume if stopped else None)



def report(title, runs, reader):
    """List (first, last) sector runs; return the length of the longest."""
    count = sum(b - a + 1 for a, b in runs)
    print(f"{title}: {count:,} sector(s) in {len(runs)} region(s):")
    for a, b in runs[:50]:
        span = f"{a}" if a == b else f"{a}-{b} ({b - a + 1} sectors)"
        print(f"  {span:>32}  {reader.locate(a)}")
    if len(runs) > 50:
        print(f"  ... and {len(runs) - 50} more regions")
    return max(b - a + 1 for a, b in runs)


def open_reader(kind, path, count, bsize, is_image, use_css):
    """Pick the reader for the media type; returns (reader, notes)."""
    notes = []
    if kind == "cd" or (kind is None and not is_image and bsize == CDDA_SECTOR):
        try:
            reader = CDReader(path)
            if any(t.audio for t in reader.tracks):
                notes.append("checking C2 error flags on audio tracks" if reader.c2
                             else "drive doesn't report C2 errors; checking "
                                  "read errors only")
            return reader, notes
        except OSError as e:
            notes.append(f"couldn't read the CD's table of contents ({e}); "
                         "reading the whole device instead")
    elif kind == "dvd" and use_css and not is_image:
        lib = load_libdvdcss()
        if lib and sg_capable(path):
            # Authenticating unlocks the drive (usually until the disc is
            # changed), so the direct reads can then be used.
            def unlock():
                h = lib.dvdcss_open(path.encode())
                if h:
                    lib.dvdcss_close(h)
                return bool(h)
            if unlock():
                return SgReader(path, count * bsize // DATA_SECTOR,
                                "direct reads, unlocked with libdvdcss",
                                unlock), notes
            notes.append("libdvdcss could not open the disc; falling back to "
                         "plain reads")
        elif lib:
            try:
                return DvdcssReader(lib, path, count * bsize // DATA_SECTOR), notes
            except OSError as e:
                notes.append(f"{e}; falling back to plain reads")
        else:
            notes.append("libdvdcss not found. If this is a CSS-protected "
                         "movie disc, the drive\n        may refuse encrypted "
                         "sectors and they will show up as errors.\n"
                         f"        Fix: {LIBDVDCSS_HINT}")
    return direct_reader(path, count, bsize), notes


def main():
    ap = argparse.ArgumentParser(
        description="Verify that every sector of a CD, DVD or Blu-ray is "
                    "readable.")
    ap.add_argument("--device", "-d",
                    help="device (e.g. /dev/disk4 or /dev/sr0) or image file; "
                         "default: the disc in the optical drive")
    ap.add_argument("--retries", "-r", type=int, default=1,
                    help="extra attempts for each failing sector (default 1)")
    ap.add_argument("--thorough", "-t", action="store_true",
                    help="don't skip regions the drive reads very slowly; "
                         "read every sector however long it takes")
    ap.add_argument("--start", "-s", type=int, default=0, metavar="SECTOR",
                    help="start at this sector, e.g. to continue a run that "
                         "was stopped")
    ap.add_argument("--end", type=int, metavar="SECTOR",
                    help="stop after this sector, e.g. to re-read just a "
                         "skipped area with --thorough")
    ap.add_argument("--no-css", action="store_true",
                    help="don't use libdvdcss for DVDs even if installed")
    ap.add_argument("--eject", "-e", action="store_true",
                    help="eject the disc when finished")
    ap.add_argument("--quiet", "-q", action="store_true",
                    help="no progress bar")
    ap.add_argument("--version", action="version",
                    version=f"%(prog)s {__version__}")
    args = ap.parse_args()

    def on_term(*_):
        raise Stop()
    # Let `kill` (SIGTERM) produce a partial report just like Ctrl-C.
    signal.signal(signal.SIGTERM, on_term)

    dev, media = args.device, None
    from_drive = dev is None
    if from_drive:
        dev, media = find_disc()
        if not dev:
            die("No disc found in the optical drive. Insert a disc, wait "
                "for it to spin up, and try again (or pass --device).")
    path = raw_path(dev)
    kind = classify(media)

    try:
        count, bsize = device_size(path)
        is_image = stat.S_ISREG(os.stat(path).st_mode)
        if LINUX and not media and stat.S_ISBLK(os.stat(path).st_mode):
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            try:
                media = linux_media(fd)
            finally:
                os.close(fd)
            kind = classify(media)
    except PermissionError:
        die(f"Permission denied opening {path}. {permission_help(path)}")
    except OSError as e:
        die(f"Cannot open {path}: {e}")

    try:
        reader, notes = open_reader(kind, path, count, bsize, is_image,
                                    not args.no_css)
    except PermissionError:
        die(f"Permission denied opening {path}. {permission_help(path)}")
    except OSError as e:
        die(f"Cannot open {path}: {e}")

    cells = [] if isinstance(reader, CDReader) else dvd_cells(path)
    if args.start or args.end is not None:
        end = float("inf") if args.end is None else args.end
        extents = [(max(a, args.start), min(b, end)) for a, b in reader.extents()
                   if b >= args.start and a <= end]
        reader.extents = lambda: extents
    total = sum(b - a + 1 for a, b in reader.extents())
    if total == 0:
        reader.close()
        die(f"{path} reports a size of 0 sectors - is a disc inserted?")
    print(f"Verifying {path}" + (f" ({media})" if media else ""))
    if isinstance(reader, CDReader):
        n_audio = sum(t.audio for t in reader.tracks)
        parts = [f"{n} {name}" for n, name in
                 ((n_audio, "audio"), (len(reader.tracks) - n_audio, "data"))
                 if n]
        print(f"  {len(reader.tracks)} track(s) ({', '.join(parts)}), "
              f"{total:,} sectors, {fmt_time(total / CD_FPS)} long")
    else:
        print(f"  {total:,} sectors, {fmt_bytes(total * reader.sector_size)}, "
              f"reading via {reader.name}")
    if kind == "bd" and count * bsize > BD50_SECTORS * DATA_SECTOR:
        notes.append("this disc is larger than 50 GB, so it is probably a 4K "
                     "UHD Blu-ray.\n        UHD discs use bus encryption, and "
                     "the drive may refuse reads\n        this tool can't "
                     "unlock; those would show up as errors.")
    for n in notes:
        print(f"  note: {n}")

    started = time.monotonic()
    try:
        r = verify(reader, args.retries, quiet=args.quiet,
                   thorough=args.thorough, cells=cells)
    finally:
        reader.close()
    elapsed = time.monotonic() - started
    bad, c2, skipped = r.bad, r.c2, r.skipped

    print()
    if r.stopped == "interrupted":
        print(f"INTERRUPTED after {r.done:,} of {total:,} sectors "
              f"({100.0 * r.done / total:.1f}%) in {fmt_time(elapsed)}.")
    elif r.stopped == "stuck":
        print(f"STOPPED after {r.done:,} of {total:,} sectors "
              f"({100.0 * r.done / total:.1f}%): the drive stopped "
              "responding.\n  Sectors it read fine earlier now fail too, so "
              "the remaining errors\n  would be the drive's, not the disc's. "
              "Unplug the drive or power-cycle\n  it to reset it.")
        if args.thorough:
            print("  Without --thorough, slow regions are skipped, which "
                  "usually avoids this.")
    if r.resume is not None:
        print(f"  To continue from sector {r.resume:,} later:\n"
              f"    {resume_command(r.resume)}")
    if r.stopped:
        print()
    if bad:
        longest = report("FAILED: unreadable", ranges(bad), reader)
        if longest >= 1000 or len(bad) > total // 100:
            print()
            print("  hint: large unbroken runs of bad sectors usually mean the "
                  "drive refused\n        to read protected content, not "
                  "that the disc is damaged.")
            if kind == "bd":
                print("        This Blu-ray may use AACS bus encryption "
                      "(common on 4K UHD\n        discs), which this tool "
                      "can't unlock. Try the disc in a player.")
            elif kind == "dvd":
                print("        Check that libdvdcss is installed and that the "
                      "drive's region\n        matches the disc's.")
            elif kind == "cd":
                print("        Some copy-protected audio CDs contain "
                      "deliberately broken\n        sectors. Try the disc in "
                      "a CD player.")
    if c2:
        if bad:
            print()
        report("DAMAGED: read with C2 errors (audio was patched over, "
               "may be audible)", ranges(c2), reader)
    if skipped:
        if bad or c2:
            print()
        report("SKIPPED: the drive read these very slowly, so they were not "
               "checked", skipped, reader)
        print()
        print("  hint: commercial discs can contain deliberately damaged "
              "areas (copy\n        protection) that players never read, "
              "and drives crawl through\n        them. On other discs, slow "
              "areas are an early sign of damage.\n        --thorough reads "
              "them anyway, but it can take hours and some\n        drives "
              "lock up until they are power-cycled.")
    if not bad and not c2 and not skipped and not r.stopped:
        print(f"OK: all {total:,} sectors read successfully "
              f"in {fmt_time(elapsed)}.")
    elif not r.stopped:
        print(f"\nFinished in {fmt_time(elapsed)}.")

    if args.eject and from_drive and not r.stopped:
        eject(dev)

    if r.stopped:
        sys.exit(130 if r.stopped == "interrupted" else 3)
    sys.exit(1 if bad or c2 or skipped else 0)


if __name__ == "__main__":
    main()
