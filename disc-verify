#!/usr/bin/env python3
"""Verify that every sector of an optical disc (CD, audio CD, DVD, Blu-ray)
can be read.

Reads the whole disc from the raw device, retries sectors that fail, and
reports any that stay unreadable. Runs on macOS and Linux. On audio CDs it also asks the drive for C2
error flags (when supported), because drives quietly conceal damaged audio
instead of returning read errors.

Usage:
    sudo disc-verify                # verify the disc in the drive
    sudo disc-verify --eject        # eject when done (handy for a box set)
    disc-verify --device disc.iso   # verify an image file instead

DVD-Video discs are usually CSS-encrypted and many drives refuse to read the
encrypted sectors until the host authenticates; libdvdcss is used for that
when installed. 4K UHD and some other Blu-rays use AACS bus encryption, which
this tool can't unlock, so such discs can show large runs of false errors.
"""

import argparse
import bisect
import ctypes
import ctypes.util
import errno
import fcntl
import glob
import grp
import mmap
import os
import re
import signal
import stat
import struct
import subprocess
import sys
import time

__version__ = "1.0.0"

LIBDVDCSS_PATH = None  # set by the Homebrew formula

DATA_SECTOR = 2048            # DVD/BD/CD-ROM (mode 1) logical sector size
CDDA_SECTOR = 2352            # audio CD sector size
C2_SIZE = 294                 # C2 error flags per CD sector (1 bit per byte)
CD_FPS = 75                   # CD sectors per second of audio
BD50_SECTORS = 24_438_784     # capacity of a dual-layer (50 GB) Blu-ray

LINUX = sys.platform.startswith("linux")

# macOS <sys/disk.h> ioctls
DKIOCGETBLOCKSIZE = 0x40046418
DKIOCGETBLOCKCOUNT = 0x40086419


def _IOWR(group, num, size):
    return 0xC0000000 | ((size & 0x1FFF) << 16) | (ord(group) << 8) | num


# <IOKit/storage/IOCDMediaBSDClient.h>, 64-bit layouts
class dk_cd_read_t(ctypes.Structure):
    _fields_ = [("offset", ctypes.c_uint64),
                ("sectorArea", ctypes.c_uint8),
                ("sectorType", ctypes.c_uint8),
                ("reserved0080", ctypes.c_uint8 * 10),
                ("bufferLength", ctypes.c_uint32),
                ("buffer", ctypes.c_void_p)]


class dk_cd_read_toc_t(ctypes.Structure):
    _fields_ = [("format", ctypes.c_uint8),
                ("formatAsTime", ctypes.c_uint8),
                ("reserved0016", ctypes.c_uint8 * 5),
                ("address", ctypes.c_uint8),
                ("reserved0064", ctypes.c_uint8 * 6),
                ("bufferLength", ctypes.c_uint16),
                ("buffer", ctypes.c_void_p)]


DKIOCCDREAD = _IOWR("d", 96, ctypes.sizeof(dk_cd_read_t))
DKIOCCDREADTOC = _IOWR("d", 100, ctypes.sizeof(dk_cd_read_toc_t))

# <IOKit/storage/IOCDTypes.h>
CD_AREA_USER = 0x10
CD_AREA_ERROR_FLAGS = 0x02
CD_TYPE_CDDA = 1
CD_TYPE_MODE1 = 2
CD_TYPE_MODE2 = 3
CD_TYPE_MODE2_FORM1 = 4
CD_TYPE_MODE2_FORM2 = 5
CD_USER_SIZE = {CD_TYPE_CDDA: 2352, CD_TYPE_MODE1: 2048, CD_TYPE_MODE2: 2336,
                CD_TYPE_MODE2_FORM1: 2048, CD_TYPE_MODE2_FORM2: 2324}
CD_DATA_TYPES = [CD_TYPE_MODE1, CD_TYPE_MODE2_FORM1, CD_TYPE_MODE2_FORM2,
                 CD_TYPE_MODE2]
CD_TOC_FORMAT_FULL = 0x02

# Linux <linux/fs.h> and <linux/cdrom.h>
BLKSSZGET = 0x1268
BLKGETSIZE64 = 0x80081272
CDROM_DRIVE_STATUS = 0x5326
CDSL_CURRENT = 0x7FFFFFFF
CDS_DISC_OK = 4

# Linux <scsi/sg.h>. On Linux the CD reads are sent to the drive as MMC
# commands. The macOS CD_AREA_* and CD_TYPE_* values above are the same bits
# the MMC READ CD command uses, so both platforms share them.
SG_IO = 0x2285
SG_DXFER_FROM_DEV = -3
SCSI_TIMEOUT_MS = 60_000
MMC_READ_TOC = 0x43
MMC_GET_CONFIGURATION = 0x46
MMC_READ_CD = 0xBE

# MMC current profile -> media type, named like drutil's Type: field
MMC_PROFILES = {
    0x08: "CD-ROM", 0x09: "CD-R", 0x0A: "CD-RW",
    0x10: "DVD-ROM", 0x11: "DVD-R", 0x12: "DVD-RAM", 0x13: "DVD-RW",
    0x14: "DVD-RW", 0x15: "DVD-R-DL", 0x16: "DVD-R-DL", 0x1A: "DVD+RW",
    0x1B: "DVD+R", 0x2A: "DVD+RW-DL", 0x2B: "DVD+R-DL",
    0x40: "BD-ROM", 0x41: "BD-R", 0x42: "BD-R", 0x43: "BD-RE",
}


class sg_io_hdr(ctypes.Structure):
    _fields_ = [("interface_id", ctypes.c_int),
                ("dxfer_direction", ctypes.c_int),
                ("cmd_len", ctypes.c_ubyte),
                ("mx_sb_len", ctypes.c_ubyte),
                ("iovec_count", ctypes.c_ushort),
                ("dxfer_len", ctypes.c_uint),
                ("dxferp", ctypes.c_void_p),
                ("cmdp", ctypes.c_void_p),
                ("sbp", ctypes.c_void_p),
                ("timeout", ctypes.c_uint),
                ("flags", ctypes.c_uint),
                ("pack_id", ctypes.c_int),
                ("usr_ptr", ctypes.c_void_p),
                ("status", ctypes.c_ubyte),
                ("masked_status", ctypes.c_ubyte),
                ("msg_status", ctypes.c_ubyte),
                ("sb_len_wr", ctypes.c_ubyte),
                ("host_status", ctypes.c_ushort),
                ("driver_status", ctypes.c_ushort),
                ("resid", ctypes.c_int),
                ("duration", ctypes.c_uint),
                ("info", ctypes.c_uint)]


def sense_message(sense):
    """Describe SCSI sense data (fixed or descriptor format)."""
    if len(sense) >= 14 and sense[0] & 0x7F in (0x70, 0x71):
        key, asc, ascq = sense[2] & 0x0F, sense[12], sense[13]
    elif len(sense) >= 4 and sense[0] & 0x7F in (0x72, 0x73):
        key, asc, ascq = sense[1] & 0x0F, sense[2], sense[3]
    else:
        return "drive reported an error"
    return f"drive reported an error (sense {key:X}/{asc:02X}/{ascq:02X})"


def scsi_read(fd, cdb, buf, n):
    """Send an MMC command that reads up to n bytes into buf (a ctypes
    buffer); return the number of bytes the drive transferred."""
    cmd = ctypes.create_string_buffer(bytes(cdb), len(cdb))
    sense = ctypes.create_string_buffer(64)
    h = sg_io_hdr(interface_id=ord("S"), dxfer_direction=SG_DXFER_FROM_DEV,
                  cmd_len=len(cdb), mx_sb_len=len(sense), dxfer_len=n,
                  dxferp=ctypes.addressof(buf), cmdp=ctypes.addressof(cmd),
                  sbp=ctypes.addressof(sense), timeout=SCSI_TIMEOUT_MS)
    fcntl.ioctl(fd, SG_IO, h)
    if h.status or h.host_status or h.driver_status or h.info & 1:
        raise OSError(errno.EIO, sense_message(sense.raw[:h.sb_len_wr]))
    return n - h.resid


def read_cd_cdb(lba, count, area, stype):
    """MMC READ CD: `area` selects the fields returned per sector (0x10 user
    data, 0x02 C2 flags) and `stype` the expected sector type."""
    return (bytes([MMC_READ_CD, stype << 2]) + lba.to_bytes(4, "big")
            + count.to_bytes(3, "big") + bytes([area, 0, 0]))


